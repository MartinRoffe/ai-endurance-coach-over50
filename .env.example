GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=yourpassword

# Daily email report
ANTHROPIC_API_KEY=sk-ant-...
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx   # myaccount.google.com/apppasswords
REPORT_TO=you@gmail.com                  # defaults to GMAIL_ADDRESS if not set

# Coach voice (optional) — natural TTS via ElevenLabs Flash (~cents per reply)
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9   # Daniel (British); pick another in ElevenLabs
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Basic auth — set both before the dashboard is reachable beyond this machine
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Bind address for `endurance-coach --serve`. Default is 127.0.0.1 (this
# machine only). The scheduled server ignores this and always binds localhost.
# For a phone or another computer, use Tailscale (`tailscale serve --bg 8743`)
# rather than 0.0.0.0 on a public or café network.
# COACH_BIND_HOST=127.0.0.1
